# =================================================================================================
# CaseGuard AI environment template.   Copy to .env for local development:   cp .env.example .env
#
#   * LOCAL / DEV ONLY. Every active default below is safe for a developer machine with the
#     bundled synthetic data and is NOT safe for any shared or production environment.
#   * This file contains NO secrets and must stay that way. Real values never go in this file or in
#     git. In Azure, secrets come from Key Vault references and identities come from managed
#     identity (see docs/CI_CD.md and infra/); nothing here is a production default.
#   * packages/config parses and validates these variables at start-up and fails fast on invalid or
#     unsafe combinations (for example AUTH_MODE=dev with APP_ENV=production is refused).
#   * `.env` is git-ignored (only *.example files are tracked). `pnpm dev` loads the repository-root
#     .env; running one app directly (`pnpm dev:api`) reads apps/api/.env instead.
#   * A commented line (`# NAME=`) is an optional variable that is unset by default; leave it unset
#     rather than setting an empty value.
# =================================================================================================

# --- Runtime identity ------------------------------------------------------------------------
# local | test | development | staging | production. Production: set by the Container Apps template.
APP_ENV=local
# Name reported in logs and telemetry.
SERVICE_NAME=caseguard-api
# Build identity. APP_VERSION defaults to the package version; GIT_COMMIT is set by the Docker build
# argument / deploy workflow (the commit SHA). Both are informational only.
# APP_VERSION=
# GIT_COMMIT=

# --- HTTP server -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
# Comma-separated browser origin allowlist. Never "*". Production: the web app's HTTPS origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Which proxies may set the client address (X-Forwarded-For) used by rate limits.
# false = ignore the header (no proxy). A number = how many proxies sit in front of the API,
# counted from the API. A comma-separated list of addresses or CIDR ranges also works. "true"
# believes every hop, so a client can choose its own address: local experiments only.
TRUST_PROXY=false
# Believe the x-cg-client-ip header as the caller's address. The web app sets it from the address its
# own ingress reported (and removes any copy a client sent), so rate limits stay per visitor even though
# every request reaches the API from the web tier. Enable only when the API is reachable from the web
# tier alone (Azure: internal ingress); never on an API that browsers can call directly.
TRUST_CLIENT_IP_HEADER=false
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Authentication --------------------------------------------------------------------------
# LOCAL AND TEST ONLY: AUTH_MODE=dev + DEV_AUTH_ENABLED=true enable the persona login (x-cg-persona
# header), which has NO real authentication. Both switches are refused (a start-up error) unless
# APP_ENV is local or test; development, staging and production need AUTH_MODE=entra and
# DEV_AUTH_ENABLED=false.
AUTH_MODE=dev
DEV_AUTH_ENABLED=true
# Microsoft Entra ID JWT validation (AUTH_MODE=entra). These are identifiers, not secrets, but they
# are environment specific: production sets them from Bicep parameters / Container App settings.
# ENTRA_TENANT_ID=
# ENTRA_AUDIENCE=
# Derivable from the tenant id when unset.
# ENTRA_ISSUER=
# ENTRA_JWKS_URI=
# JSON map of Entra tenant id -> CaseGuard tenant id, e.g. {"<entra-tenant-guid>":"tenant_contoso_support"}
# ENTRA_TENANT_MAP=
# JSON map of Entra app role -> CaseGuard role. Sensible defaults apply when unset.
# ENTRA_ROLE_MAP=

# --- Database --------------------------------------------------------------------------------
# pglite://.data/caseguard  embedded PostgreSQL (PGlite) on disk: zero dependencies, local/test only
# pglite://memory           embedded and ephemeral
# postgres://USER:PASSWORD@HOST:5432/DB  a real PostgreSQL (for example `docker compose up postgres`;
#                                        the compose database listens on 127.0.0.1:55432)
# Production uses PostgreSQL Flexible Server. Prefer DATABASE_AUTH=entra there so that no password
# exists at all; if a password is unavoidable it comes from a Key Vault reference, never from here.
DATABASE_URL=pglite://.data/caseguard
# password | entra (managed-identity access token used as the password)
DATABASE_AUTH=password
# Run SQL migrations at start-up. Default true for local/test and false otherwise: deployed
# environments run `node dist/db/migrate-cli.js` once per release as a separate migration job.
DB_AUTO_MIGRATE=true
DB_POOL_MAX=10
# DEV ONLY password for the docker compose PostgreSQL container; also embedded in its DATABASE_URL.
# Use a URL-safe value. Compose falls back to a documented dev-only default when unset.
# POSTGRES_PASSWORD=
# Host port published by compose for PostgreSQL (loopback only).
# POSTGRES_HOST_PORT=55432
# PostgreSQL used by the integration tests when you do not want PGlite, e.g.
# postgres://USER:PASSWORD@127.0.0.1:55432/caseguard_test. CI provides its own service container.
# TEST_DATABASE_URL=

# --- Object storage --------------------------------------------------------------------------
# local | azure-blob. azure-blob authenticates with managed identity (DefaultAzureCredential); no
# account key or connection string is supported or needed.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.data/objects
# AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=cases

# --- Search and cache ------------------------------------------------------------------------
# lexical (PostgreSQL full-text) | azure-ai-search (managed identity)
SEARCH_PROVIDER=lexical
# AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=caseguard
# memory is the only implemented cache. A Redis provider is reserved but not implemented.
CACHE_PROVIDER=memory

# --- AI provider -----------------------------------------------------------------------------
# deterministic (knowledge-pack provider, no network) | azure-openai (not validated against a live
# deployment; see docs/ASSUMPTIONS.md).
AI_PROVIDER=deterministic
# With azure-openai: the endpoint is a bare https origin such as https://<resource>.openai.azure.com
# (a trailing slash is fine; no path, query, fragment or credentials) and the deployment name is 1 to
# 64 letters, digits, ".", "_" or "-", starting with a letter or digit. Anything else stops start-up.
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# managed-identity (default, and the only option for deployed environments) | api-key
AZURE_OPENAI_AUTH=managed-identity
# DEV ONLY, local experiments with AZURE_OPENAI_AUTH=api-key. Never commit a key. Deployed
# environments use managed identity and must not set it.
# AZURE_OPENAI_API_KEY=
AI_MAX_INPUT_TOKENS=24000
AI_MAX_OUTPUT_TOKENS=4000
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
# Daily spend cap in USD; unset means no cap. Requires the unit prices below to be meaningful.
# AI_COST_LIMIT_USD_PER_DAY=
# Operator-supplied price per 1K tokens. Prices are never hard-coded: when unset, cost is reported as
# unknown rather than invented.
# AI_UNIT_PRICE_INPUT_PER_1K=
# AI_UNIT_PRICE_OUTPUT_PER_1K=

# --- Limits and safety -----------------------------------------------------------------------
# In-memory, per replica (see docs/THREAT_MODEL.md for the multi-replica caveat).
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AI_MAX=30
BODY_LIMIT_BYTES=1048576
UPLOAD_MAX_BYTES=2097152
# none | eicar-test (integration hook for tests; no scanner is bundled)
MALWARE_SCAN_MODE=none

# --- Telemetry -------------------------------------------------------------------------------
# Azure Monitor / Application Insights connection string. Treat it as sensitive: production supplies
# it through a Key Vault reference; leave it unset locally.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# Defaults to SERVICE_NAME when unset.
# OTEL_SERVICE_NAME=
OTEL_SAMPLING_RATIO=1

# --- Demo ------------------------------------------------------------------------------------
# DEV / DEMO ONLY. Enables the demo seed/reset routes and seeds the bundled SYNTHETIC data at
# start-up. Default true locally and false in production.
DEMO_MODE=true
DEMO_AUTO_SEED=true

# --- Web application (Next.js) -----------------------------------------------------------------
# NEXT_PUBLIC_* values are visible to every browser and are inlined at BUILD time (rebuild the web
# app or image after changing them). They are public identifiers, never secrets.
NEXT_PUBLIC_AUTH_MODE=dev
# NEXT_PUBLIC_ENTRA_CLIENT_ID=
# NEXT_PUBLIC_ENTRA_AUTHORITY=
# NEXT_PUBLIC_ENTRA_API_SCOPE=
NEXT_PUBLIC_APP_ENV=local
# Optional: how strictly the browser checks API responses against the Zod schemas. always | sample | off.
# Unset means "always" in development and "off" in production builds.
# NEXT_PUBLIC_API_VALIDATION=
# Server-side target of the same-origin /api proxy (apps/web/src/proxy.ts). A plain runtime variable of
# the web server, read on every request (not baked into the build). Required in production: a missing
# or invalid value answers 502 upstream_not_configured. Docker compose uses http://api:4000; Azure uses
# the API's internal address.
API_INTERNAL_URL=http://localhost:4000
