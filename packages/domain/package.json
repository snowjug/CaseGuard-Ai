{
  "name": "@caseguard/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure, deterministic analysis engine: temporal view, knowledge packs, evidence classification, Bayesian hypotheses, action value, forks, counterfactuals, quality, ASE, SkillDNA.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "bench": "tsx bench/bench.ts",
    "eval": "tsx test/evaluation/run.ts dev",
    "eval:check": "tsx test/evaluation/check.ts",
    "eval:dev": "tsx test/evaluation/run.ts dev",
    "eval:validation": "tsx test/evaluation/run.ts validation",
    "eval:locked": "tsx test/evaluation/run.ts locked",
    "eval:manifest": "tsx test/evaluation/manifest.ts",
    "eval:coverage": "tsx test/evaluation/coverage.ts",
    "eval:annotate": "tsx test/evaluation/annotate.ts",
    "eval:agreement": "tsx test/evaluation/agreement.ts",
    "eval:migrate": "tsx test/evaluation/migrate-wave1.ts",
    "eval:vocabulary": "tsx test/evaluation/vocabulary.ts"
  },
  "dependencies": {
    "@caseguard/schemas": "workspace:*",
    "@caseguard/security": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
