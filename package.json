{
  "name": "caseguard-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-grounded counterfactual quality platform for technical support. Synthetic demo data only.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @caseguard/api dev",
    "dev:web": "pnpm --filter @caseguard/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.int.test.ts\"",
    "test:int": "vitest run .int.test",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "test:e2e:ui": "playwright test --ui --project=desktop --project=mobile",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "db:migrate": "pnpm --filter @caseguard/api db:migrate",
    "bench": "pnpm --filter @caseguard/domain bench --",
    "bench:api": "tsx scripts/bench-api.ts",
    "bench:engine": "tsx scripts/bench-engine.ts",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "audit:deps": "node scripts/audit-deps.mjs",
    "infra:validate": "node scripts/infra-validate.mjs",
    "docker:build": "node scripts/docker-build.mjs",
    "schemas:export": "tsx scripts/export-json-schemas.ts",
    "samples:export": "tsx scripts/export-samples.ts",
    "docs:api": "tsx scripts/export-api-docs.ts",
    "docs:check": "node scripts/check-docs.mjs",
    "screenshots": "playwright test --project=screenshots",
    "verify": "node scripts/verify.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "catalog:",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.0",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js,json,md,yml,yaml,css}": "prettier --write"
  }
}
