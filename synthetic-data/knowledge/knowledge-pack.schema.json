                    "roles": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "customer_admin",
                          "customer_end_user",
                          "customer_network_admin",
                          "support_engineer",
                          "escalation_engineer",
                          "support_manager",
                          "system"
