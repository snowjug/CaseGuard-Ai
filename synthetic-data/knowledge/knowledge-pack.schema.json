          "computeUnits": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "customerEffort": {
            "type": "string",
            "enum": ["none", "low", "medium", "high", "very_high"]
          },
          "operationalRisk": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "destructive": {
            "type": "boolean"
          },
          "requiresApproval": {
            "type": "boolean"
          },
          "reliability": {
            "type": "number",
            "minimum": 0.05,
            "maximum": 1
