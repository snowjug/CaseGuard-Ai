{
  "$id": "https://caseguard.example/schemas/knowledge-pack.schema.json",
  "title": "CaseGuard workload knowledge pack",
  "description": "Authored domain model used by the deterministic provider and as grounding for model prompts.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^kp\\.[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "workload": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 600
    },
    "disclaimer": {
      "type": "string",
      "minLength": 20,
      "maxLength": 500
    },
    "hypotheses": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^hyp\\.[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 600
          },
          "category": {
            "type": "string",
            "enum": ["identity", "network", "client", "service", "configuration", "unknown"]
          },
          "prior": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "assumptions": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "keywords": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 60
            }
          },
          "validatingActionIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confirmationRequirementIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["id", "name", "description", "category", "prior"]
      }
    },
    "signals": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sig\\.[a-z0-9-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 400
          },
          "detectors": {
            "minItems": 1,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "regex"
                    },
                    "pattern": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "flags": {
                      "default": "i",
                      "type": "string",
                      "maxLength": 8
                    },
                    "eventTypes": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "customer_email",
                          "customer_call",
                          "engineer_email",
                          "case_note",
                          "engineer_action",
                          "diagnostic_result",
                          "log_sample",
                          "query_output",
                          "escalation",
                          "escalation_response",
                          "status_change",
                          "resolution_note",
                          "validation_result",
                          "system_event"
                        ]
                      }
                    },
                    "roles": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "customer_admin",
                          "customer_end_user",
                          "customer_network_admin",
                          "support_engineer",
                          "escalation_engineer",
                          "support_manager",
                          "system"
                        ]
                      }
                    }
                  },
                  "required": ["kind", "pattern"]
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "structured"
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "op": {
                      "type": "string",
                      "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "includes", "exists"]
                    },
                    "value": {
                      "type": ["string", "number", "boolean"]
                    },
                    "eventTypes": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "customer_email",
                          "customer_call",
                          "engineer_email",
                          "case_note",
                          "engineer_action",
                          "diagnostic_result",
                          "log_sample",
                          "query_output",
                          "escalation",
                          "escalation_response",
                          "status_change",
                          "resolution_note",
                          "validation_result",
                          "system_event"
                        ]
                      }
                    }
                  },
                  "required": ["kind", "key", "op"]
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "structured_all"
                    },
                    "conditions": {
                      "minItems": 2,
                      "maxItems": 6,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                          },
                          "op": {
                            "type": "string",
                            "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "includes", "exists"]
                          },
                          "value": {
                            "type": ["string", "number", "boolean"]
                          }
                        },
                        "required": ["key", "op"]
                      }
                    },
                    "eventTypes": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "customer_email",
                          "customer_call",
                          "engineer_email",
                          "case_note",
                          "engineer_action",
                          "diagnostic_result",
                          "log_sample",
                          "query_output",
                          "escalation",
                          "escalation_response",
                          "status_change",
                          "resolution_note",
                          "validation_result",
                          "system_event"
                        ]
                      }
                    }
                  },
                  "required": ["kind", "conditions"]
                }
              ]
            }
          },
          "strength": {
            "type": "string",
            "enum": ["strong", "moderate", "weak"]
          },
          "evidenceKind": {
            "default": "presence",
            "type": "string",
            "enum": ["presence", "absence"]
          },
          "category": {
            "type": "string",
            "enum": [
              "confirmed_fact",
              "customer_reported",
              "engineer_assumption",
              "diagnostic_evidence",
              "ai_inference",
              "conflicting_evidence",
              "missing_evidence",
              "simulated_outcome"
            ]
          },
          "likelihoods": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 0.99
            }
          },
          "neutral": {
            "default": 0.5,
            "type": "number",
            "minimum": 0.01,
            "maximum": 0.99
          },
          "explanation": {
            "type": "string",
            "maxLength": 500
          },
          "satisfies": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "twinSection": {
            "type": "string",
            "enum": [
              "problem_statement",
              "customer_impact",
              "environment",
              "scope",
              "participants",
              "observations",
              "actions",
              "decisions",
              "communications",
              "escalations",
              "resolution",
              "validation",
              "remaining_risks",
              "unknowns"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "description",
          "detectors",
          "strength",
          "category",
          "likelihoods",
          "explanation"
        ]
      }
