                        "type": "string",
                        "enum": [
                          "customer_email",
                          "customer_call",
                          "engineer_email",
                          "case_note",
                          "engineer_action",
                          "diagnostic_result",
                          "log_sample",
                          "query_output",
                          "escalation",
